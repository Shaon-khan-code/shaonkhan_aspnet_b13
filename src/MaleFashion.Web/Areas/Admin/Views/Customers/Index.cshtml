@model List<MaleFashion.Web.Areas.Admin.ViewModels.Customers.CustomerListItemViewModel>

@{
    ViewData["Title"] = "Customers";
    var totalPages = (int)ViewData["TotalPages"]!;
    var currentPage = (int)ViewData["PageNumber"]!;
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-3">Customers</h5>
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-6">
                <input type="text" name="searchTerm" value="@ViewData["SearchTerm"]" class="form-control" placeholder="Search by email or name..." />
            </div>
            <div class="col-md-6 d-flex gap-2">
                <button type="submit" class="btn btn-secondary">Search</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>

    @if (Model.Count == 0)
    {
        <div class="card-body text-center text-body-secondary py-5 border-top">
            No customers found.
        </div>
    }
    else
    {
        <div class="table-responsive text-nowrap">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>Full Name</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td>@customer.Email</td>
                            <td><strong>@customer.FullName</strong></td>
                            <td>@customer.PhoneNumber</td>
                            <td>
                                @if (customer.IsLockedOut)
                                {
                                    <span class="badge bg-label-danger">Inactive</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-success">Active</span>
                                }
                            </td>
                            <td class="text-end"><a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-secondary">View</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (totalPages > 1)
    {
        <div class="card-footer">
            <nav aria-label="Customer pages">
                <ul class="pagination justify-content-center mb-0">
                    @for (var i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-searchTerm="@ViewData["SearchTerm"]">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
