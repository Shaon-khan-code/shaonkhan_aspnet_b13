@using System.Globalization
@using MaleFashion.Domain.Enums
@model MaleFashion.Application.DTOs.OrderDto

@{
    ViewData["Title"] = "Order " + Model.OrderNumber;
    var us = CultureInfo.GetCultureInfo("en-US");

    string StatusColor(string value) => value.ToLowerInvariant() switch
    {
        "pending" or "processing" => "warning",
        "shipped" => "primary",
        "delivered" or "completed" or "paid" => "success",
        "cancelled" or "canceled" or "failed" or "refunded" => "danger",
        _ => "secondary"
    };
    var status = Convert.ToString(Model.Status) ?? string.Empty;
    var payment = Convert.ToString(Model.PaymentStatus) ?? string.Empty;
    var method = Convert.ToString(Model.PaymentMethod) ?? string.Empty;

    var isWallet = method.Equals("Bkash", StringComparison.OrdinalIgnoreCase)
                   || method.Equals("Nagad", StringComparison.OrdinalIgnoreCase);
    var awaitingVerification = isWallet && payment.Equals("Pending", StringComparison.OrdinalIgnoreCase)
                               && !status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase);
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-6">
    <div class="col-xl-8">
        <div class="card mb-6">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h5 class="mb-0">Order @Model.OrderNumber</h5>
                <span class="badge bg-label-@StatusColor(status)">@status</span>
            </div>
            <div class="table-responsive text-nowrap">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody class="table-border-bottom-0">
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.Quantity</td>
                                <td>@item.UnitPrice.ToString("C", us)</td>
                                <td class="text-end">@item.LineTotal.ToString("C", us)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-body text-end">
                <h5 class="mb-0">Total: @Model.TotalAmount.ToString("C", us)</h5>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card mb-6">
            <h5 class="card-header">Details</h5>
            <div class="card-body">
                <dl class="mb-0">
                    <dt>Placed on</dt>
                    <dd>@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm", us)</dd>
                    <dt>Payment status</dt>
                    <dd><span class="badge bg-label-@StatusColor(payment)">@payment</span></dd>
                    <dt>Payment method</dt>
                    <dd>@method</dd>
                    @if (!string.IsNullOrEmpty(Model.PaymentAccount))
                    {
                        <dt>Sender wallet number</dt>
                        <dd>@Model.PaymentAccount</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.PaymentReference))
                    {
                        <dt>Transaction ID (TrxID)</dt>
                        <dd><code>@Model.PaymentReference</code></dd>
                    }
                    <dt>Shipping address</dt>
                    <dd class="mb-0">
                        @Model.ShippingAddress.FullName<br />
                        @Model.ShippingAddress.Line1
                        @if (!string.IsNullOrEmpty(Model.ShippingAddress.Line2))
                        {
                            <text>, @Model.ShippingAddress.Line2</text>
                        }
                        <br />
                        @Model.ShippingAddress.City, @Model.ShippingAddress.PostalCode<br />
                        @Model.ShippingAddress.Country<br />
                        @Model.ShippingAddress.Phone
                    </dd>
                </dl>
            </div>
        </div>

        @if (awaitingVerification)
        {
            <div class="card mb-6 border border-warning">
                <h5 class="card-header">Verify payment</h5>
                <div class="card-body">
                    <p class="small mb-3">
                        Check your @method app for a payment of <strong>@Model.TotalAmount.ToString("C", us)</strong>
                        with the TrxID above. Only confirm after you have received the money.
                    </p>
                    <form asp-action="MarkPaid" method="post"
                          onsubmit="return confirm('Have you received this payment in your @method account?');">
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        <button type="submit" class="btn btn-success">Mark as Paid</button>
                    </form>
                </div>
            </div>
        }

        <div class="card mb-6">
            <h5 class="card-header">Update status</h5>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="OrderId" value="@Model.Id" />
                    <label class="form-label">Order Status</label>
                    <select name="Status" class="form-select mb-4">
                        @foreach (var s in Enum.GetValues<OrderStatus>())
                        {
                            <option value="@s" selected="@(Model.Status == s)">@s</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Update Status</button>
                </form>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Back to Orders</a>
    </div>
</div>
