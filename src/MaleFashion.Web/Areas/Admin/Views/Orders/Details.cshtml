@model MaleFashion.Application.DTOs.OrderDto
@using MaleFashion.Domain.Enums

<h1>Order @Model.OrderNumber</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<dl class="row">
    <dt class="col-sm-2">Placed On</dt>
    <dd class="col-sm-10">@Model.CreatedAt.ToString("g")</dd>

    <dt class="col-sm-2">Payment Status</dt>
    <dd class="col-sm-10"><span class="badge bg-secondary">@Model.PaymentStatus</span></dd>

    <dt class="col-sm-2">Shipping Address</dt>
    <dd class="col-sm-10">
        @Model.ShippingAddress.FullName<br />
        @Model.ShippingAddress.Line1
        @if (!string.IsNullOrEmpty(Model.ShippingAddress.Line2))
        {
            <text>, @Model.ShippingAddress.Line2</text>
        }
        <br />
        @Model.ShippingAddress.City, @Model.ShippingAddress.PostalCode<br />
        @Model.ShippingAddress.Country<br />
        @Model.ShippingAddress.Phone
    </dd>
</dl>

<h3>Items</h3>
<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Line Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("C")</td>
                <td>@item.LineTotal.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-end mb-3">
    <h4>Total: @Model.TotalAmount.ToString("C")</h4>
</div>

<form asp-action="UpdateStatus" method="post" class="row g-2 align-items-end">
    <input type="hidden" name="OrderId" value="@Model.Id" />
    <div class="col-auto">
        <label class="form-label">Order Status</label>
        <select name="Status" class="form-select">
            @foreach (var s in Enum.GetValues<OrderStatus>())
            {
                <option value="@s" selected="@(Model.Status == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Update Status</button>
    </div>
</form>

<a asp-action="Index" class="btn btn-secondary mt-3">Back to Orders</a>