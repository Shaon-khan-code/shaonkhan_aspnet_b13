@model MaleFashion.Web.Areas.Admin.ViewModels.Products.ProductFormViewModel

@{
    ViewData["Title"] = "Edit Product";
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-6">
        <div class="col-xl-8">
            <div class="card mb-6">
                <h5 class="card-header">Product information</h5>
                <div class="card-body">
                    <div class="row g-6">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Slug" class="form-label"></label>
                            <input asp-for="Slug" class="form-control" />
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Sku" class="form-label"></label>
                            <input asp-for="Sku" class="form-control" />
                            <span asp-validation-for="Sku" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-6">
                <h5 class="card-header">Image</h5>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                    {
                        <div class="mb-3">
                            <label class="form-label">Current Image</label>
                            <div><img src="@Model.CurrentImageUrl" alt="@Model.Name" class="img-fluid rounded border" style="max-height: 200px;" /></div>
                        </div>
                    }
                    <div>
                        <label asp-for="ImageFile" class="form-label">Replace Image</label>
                        <input asp-for="ImageFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" />
                        <span asp-validation-for="ImageFile" class="text-danger"></span>
                        <div class="form-text">Leave empty to keep the current image.</div>
                    </div>
                    <img id="imagePreview" class="img-fluid rounded border mt-3 d-none" alt="Selected image preview" style="max-height: 200px;" />
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card mb-6">
                <h5 class="card-header">Pricing &amp; category</h5>
                <div class="card-body">
                    <div class="row g-6">
                        <div class="col-12">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="DiscountPrice" class="form-label"></label>
                            <input asp-for="DiscountPrice" class="form-control" />
                            <span asp-validation-for="DiscountPrice" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="CategoryId" class="form-label"></label>
                            <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <button type="submit" class="btn btn-primary me-2">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var input = document.getElementById('ImageFile');
            var preview = document.getElementById('imagePreview');
            if (!input || !preview) return;

            input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (!file) { preview.classList.add('d-none'); return; }
                preview.src = URL.createObjectURL(file);
                preview.classList.remove('d-none');
            });
        })();
    </script>
}
