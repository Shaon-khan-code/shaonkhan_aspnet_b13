@model MaleFashion.Application.DTOs.ProductDto

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

<p>Are you sure you want to delete <strong>@Model.Name</strong> (SKU: @Model.Sku)?</p>
<p class="text-muted">If this product has existing orders, deletion will be blocked — consider marking it Inactive instead.</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>