@using MaleFashion.Web.Helpers
@model object
@{
    ViewData["Title"] = "Shopping Cart";

    var lines = Model.ToCartLines();
    var (subtotal, total) = Model.GetCartTotals(lines);
}

<style>
    .cart-qty-form {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 0;
    }

    .cart-qty-input {
        width: 72px;
        height: 40px;
        text-align: center;
        border: 1px solid #e1e1e1;
        background: #fff;
    }

    .cart-icon-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px 8px;
        color: #111;
        font-size: 15px;
        transition: color .2s;
    }

        .cart-icon-btn:hover {
            color: #e53637;
        }

    .cart-thumb {
        width: 90px;
        height: 90px;
        object-fit: cover;
    }
</style>

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Shopping Cart</h4>
                    <div class="breadcrumb__links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Shop" asp-action="Index">Shop</a>
                        <span>Shopping Cart</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Shopping Cart Section Begin -->
<section class="shopping-cart spad">
    <div class="container">

        @if (TempData["CartSuccess"] is string cartSuccess)
        {
            <div class="alert alert-success" role="alert">@cartSuccess</div>
        }
        @if (TempData["CartError"] is string cartError)
        {
            <div class="alert alert-danger" role="alert">@cartError</div>
        }

        @if (lines.Count == 0)
        {
            <div class="text-center py-5">
                <h4>Your cart is empty</h4>
                <p class="mb-4">Looks like you haven't added anything yet.</p>
                <a asp-controller="Shop" asp-action="Index" class="primary-btn">Start shopping</a>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8">
                    <div class="shopping__cart__table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in lines)
                                {
                                    <tr>
                                        <td class="product__cart__item">
                                            <div class="product__cart__item__pic">
                                                <img class="cart-thumb" src="@line.Image" alt="@line.Name">
                                            </div>
                                            <div class="product__cart__item__text">
                                                <h6>@line.Name</h6>
                                                <h5>@ModelReader.Money(line.UnitPrice)</h5>
                                            </div>
                                        </td>
                                        <td class="quantity__item">
                                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="cart-qty-form">
                                                <input type="hidden" name="cartItemId" value="@line.Id" />
                                                <input type="number" name="quantity" value="@line.Quantity" min="1" max="99" class="cart-qty-input" aria-label="Quantity" />
                                                <button type="submit" class="cart-icon-btn" title="Update quantity"><i class="fa fa-refresh"></i></button>
                                            </form>
                                        </td>
                                        <td class="cart__price">@ModelReader.Money(line.LineTotal)</td>
                                        <td class="cart__close">
                                            <form asp-controller="Cart" asp-action="Remove" method="post" style="margin:0;">
                                                <input type="hidden" name="cartItemId" value="@line.Id" />
                                                <button type="submit" class="cart-icon-btn" title="Remove item"><i class="fa fa-close"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="continue__btn">
                                <a asp-controller="Shop" asp-action="Index">Continue Shopping</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="cart__total">
                        <h6>Cart total</h6>
                        <ul>
                            <li>Subtotal <span>@ModelReader.Money(subtotal)</span></li>
                            <li>Total <span>@ModelReader.Money(total)</span></li>
                        </ul>
                        <a asp-controller="Checkout" asp-action="Index" class="primary-btn">Proceed to checkout</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
<!-- Shopping Cart Section End -->
