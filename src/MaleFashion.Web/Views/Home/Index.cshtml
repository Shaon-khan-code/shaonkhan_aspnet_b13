@{
    ViewData["Title"] = "Home";

    var slides = new[]
    {
        (Image: "hero-1.jpg", Eyebrow: "Summer Collection", Title: "Fall - Winter Collections 2030"),
        (Image: "hero-2.jpg", Eyebrow: "Summer Collection", Title: "Fall - Winter Collections 2030")
    };

    var banners = new[]
    {
        (Column: "col-lg-7 offset-lg-4", Style: "",                    Image: "banner-1.jpg", Title: "Clothing Collections 2030"),
        (Column: "col-lg-5",             Style: "banner__item--middle", Image: "banner-2.jpg", Title: "Accessories"),
        (Column: "col-lg-7",             Style: "banner__item--last",   Image: "banner-3.jpg", Title: "Shoes Spring 2030")
    };

    var news = new[]
    {
        (Image: "blog-1.jpg", Date: "16 February 2020", Title: "What Curling Irons Are The Best Ones"),
        (Image: "blog-2.jpg", Date: "21 February 2020", Title: "Eternity Bands Do Last Forever"),
        (Image: "blog-3.jpg", Date: "28 February 2020", Title: "The Health Benefits Of Sunglasses")
    };
}

<!-- Hero Section Begin -->
<section class="hero">
    <div class="hero__slider owl-carousel">
        @foreach (var slide in slides)
        {
            <div class="hero__items set-bg" data-setbg="/storefront/img/hero/@slide.Image">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-5 col-lg-7 col-md-8">
                            <div class="hero__text">
                                <h6>@slide.Eyebrow</h6>
                                <h2>@slide.Title</h2>
                                <p>
                                    A specialist label creating luxury essentials. Ethically crafted with an unwavering
                                    commitment to exceptional quality.
                                </p>
                                <a asp-controller="Shop" asp-action="Index" class="primary-btn">Shop now <span class="arrow_right"></span></a>
                                <div class="hero__social">
                                    <a href="#" aria-label="Facebook"><i class="fa fa-facebook"></i></a>
                                    <a href="#" aria-label="Twitter"><i class="fa fa-twitter"></i></a>
                                    <a href="#" aria-label="Pinterest"><i class="fa fa-pinterest"></i></a>
                                    <a href="#" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
<!-- Hero Section End -->
<!-- Banner Section Begin -->
<section class="banner spad">
    <div class="container">
        <div class="row">
            @foreach (var banner in banners)
            {
                <div class="@banner.Column">
                    <div class="banner__item @banner.Style">
                        <div class="banner__item__pic">
                            <img src="/storefront/img/banner/@banner.Image" alt="@banner.Title">
                        </div>
                        <div class="banner__item__text">
                            <h2>@banner.Title</h2>
                            <a asp-controller="Shop" asp-action="Index">Shop now</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Banner Section End -->
<!-- Product Section: ডেটাবেস থেকে -->
@await Component.InvokeAsync("FeaturedProducts")

<!-- Categories Section Begin -->
<section class="categories spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-3">
                <div class="categories__text">
                    <h2>Clothings Hot <br /> <span>Shoe Collection</span> <br /> Accessories</h2>
                </div>
            </div>
            @await Component.InvokeAsync("DealOfTheWeek")
        </div>
    </div>
</section>
<!-- Categories Section End -->
<!-- Instagram Section Begin -->
<section class="instagram spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="instagram__pic">
                    @for (var i = 1; i <= 6; i++)
                    {
                        <div class="instagram__pic__item set-bg" data-setbg="/storefront/img/instagram/instagram-@(i).jpg"></div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="instagram__text">
                    <h2>Instagram</h2>
                    <p>
                        Follow us for daily outfit ideas, new arrivals and behind-the-scenes looks from the MaleFashion team.
                    </p>
                    <h3>#Male_Fashion</h3>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Instagram Section End -->
<!-- Latest Blog Section Begin -->
<section class="latest spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Latest News</span>
                    <h2>Fashion New Trends</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var post in news)
            {
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="blog__item">
                        <div class="blog__item__pic set-bg" data-setbg="/storefront/img/blog/@post.Image"></div>
                        <div class="blog__item__text">
                            <span><img src="/storefront/img/icon/calendar.png" alt=""> @post.Date</span>
                            <h5>@post.Title</h5>
                            <a asp-controller="Blog" asp-action="Index">Read More</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Latest Blog Section End -->
