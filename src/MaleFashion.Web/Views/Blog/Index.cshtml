@{
    ViewData["Title"] = "Blog";

    var posts = new[]
    {
        (Img: "blog-1.jpg", Date: "16 February 2020", Title: "What Curling Irons Are The Best Ones"),
        (Img: "blog-2.jpg", Date: "21 February 2020", Title: "Eternity Bands Do Last Forever"),
        (Img: "blog-3.jpg", Date: "28 February 2020", Title: "The Health Benefits Of Sunglasses"),
        (Img: "blog-4.jpg", Date: "16 February 2020", Title: "Aiming For Higher The Mastopexy"),
        (Img: "blog-5.jpg", Date: "21 February 2020", Title: "Wedding Rings A Gift For A Lifetime"),
        (Img: "blog-6.jpg", Date: "28 February 2020", Title: "The Different Methods Of Hair Removal"),
        (Img: "blog-7.jpg", Date: "16 February 2020", Title: "Hoop Earrings A Style From History"),
        (Img: "blog-8.jpg", Date: "21 February 2020", Title: "Lasik Eye Surgery Are You Ready"),
        (Img: "blog-9.jpg", Date: "28 February 2020", Title: "Lasik Eye Surgery Are You Ready")
    };
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-blog set-bg" data-setbg="/storefront/img/breadcrumb-bg.jpg">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h2>Our Blog</h2>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- Blog Section Begin -->
<section class="blog spad">
    <div class="container">
        <div class="row">
            @foreach (var post in posts)
            {
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="blog__item">
                        <div class="blog__item__pic set-bg" data-setbg="/storefront/img/blog/@post.Img"></div>
                        <div class="blog__item__text">
                            <span><img src="/storefront/img/icon/calendar.png" alt=""> @post.Date</span>
                            <h5>@post.Title</h5>
                            <a href="#">Read More</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Blog Section End -->
