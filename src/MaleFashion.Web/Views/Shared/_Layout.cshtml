<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaleFashion.Web</title>

    <!-- Storefront template CSS -->
    <link rel="stylesheet" href="~/storefront/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/storefront/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/storefront/css/elegant-icons.css">
    <link rel="stylesheet" href="~/storefront/css/slicknav.min.css">
    <link rel="stylesheet" href="~/storefront/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/storefront/css/nice-select.css">
    <link rel="stylesheet" href="~/storefront/css/magnific-popup.css">
    <link rel="stylesheet" href="~/storefront/css/style.css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Page Preloder -->
    <div id="preloder">
        <div class="loader"></div>
    </div>

    <!-- Offcanvas Menu Begin -->
    <div class="offcanvas-menu-overlay"></div>
    <div class="offcanvas-menu-wrapper">
        <div class="offcanvas__option">
            <div class="offcanvas__links">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a href="/admin">Admin</a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        <button type="submit" style="background:none;border:none;color:inherit;padding:0;cursor:pointer;">Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                }
                <a href="#">FAQs</a>
            </div>
            <div class="offcanvas__top__hover">
                <span>Usd <i class="arrow_carrot-down"></i></span>
                <ul>
                    <li>USD</li>
                    <li>EUR</li>
                    <li>USD</li>
                </ul>
            </div>
        </div>
        <div class="offcanvas__nav__option">
            <a href="#" class="search-switch"><img src="~/storefront/img/icon/search.png" alt=""></a>
            <a href="#"><img src="~/storefront/img/icon/heart.png" alt=""></a>
            <a asp-controller="Cart" asp-action="Index"><img src="~/storefront/img/icon/cart.png" alt=""> <span>0</span></a>
            <div class="price">$0.00</div>
        </div>
        <div id="mobile-menu-wrap"></div>
        <div class="offcanvas__text">
            <p>Free shipping, 30-day return or refund guarantee.</p>
        </div>
    </div>
    <!-- Offcanvas Menu End -->
    <!-- Header Section Begin -->
    <header class="header">
        <div class="header__top">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 col-md-7">
                        <div class="header__top__left">
                            <p>Free shipping, 30-day return or refund guarantee.</p>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-5">
                        <div class="header__top__right">
                            <div class="header__top__links">
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a href="/admin">Admin</a>
                                    }
                                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                                        <button type="submit" style="background:none;border:none;color:inherit;padding:0;cursor:pointer;">Logout</button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                                }
                                <a href="#">FAQs</a>
                            </div>
                            <div class="header__top__hover">
                                <span>Usd <i class="arrow_carrot-down"></i></span>
                                <ul>
                                    <li>USD</li>
                                    <li>EUR</li>
                                    <li>USD</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-3">
                    <div class="header__logo">
                        <a asp-controller="Home" asp-action="Index"><img src="~/storefront/img/logo.png" alt=""></a>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6">
                    <nav class="header__menu mobile-menu">
                        <ul>
                            <li class="active"><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                            <li>
                                <a href="#">Pages</a>
                                <ul class="dropdown">
                                    <li><a asp-controller="About" asp-action="Index">About Us</a></li>
                                    <li><a asp-controller="Cart" asp-action="Index">Shopping Cart</a></li>
                                    <li><a asp-controller="Checkout" asp-action="Index">Check Out</a></li>
                                    <li><a asp-controller="Orders" asp-action="Index">Orders</a></li>
                                </ul>
                            </li>
                            <li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
                            <li><a asp-controller="Contact" asp-action="Index">Contacts</a></li>
                        </ul>
                    </nav>
                </div>
                <div class="col-lg-3 col-md-3">
                    <div class="header__nav__option">
                        <a href="#" class="search-switch"><img src="~/storefront/img/icon/search.png" alt=""></a>
                        <a href="#"><img src="~/storefront/img/icon/heart.png" alt=""></a>
                        <a asp-controller="Cart" asp-action="Index"><img src="~/storefront/img/icon/cart.png" alt=""> <span>0</span></a>
                        <div class="price">$0.00</div>
                    </div>
                </div>
            </div>
            <div class="canvas__open"><i class="fa fa-bars"></i></div>
        </div>
    </header>
    <!-- Header Section End -->

    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer Section Begin -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="footer__about">
                        <div class="footer__logo">
                            <a asp-controller="Home" asp-action="Index"><img src="~/storefront/img/footer-logo.png" alt=""></a>
                        </div>
                        <p>The customer is at the heart of our unique business model, which includes design.</p>
                        <a href="#"><img src="~/storefront/img/payment.png" alt=""></a>
                    </div>
                </div>
                <div class="col-lg-2 offset-lg-1 col-md-3 col-sm-6">
                    <div class="footer__widget">
                        <h6>Shopping</h6>
                        <ul>
                            <li><a asp-controller="Shop" asp-action="Index">Clothing Store</a></li>
                            <li><a asp-controller="Shop" asp-action="Index">Trending Shoes</a></li>
                            <li><a asp-controller="Shop" asp-action="Index">Accessories</a></li>
                            <li><a asp-controller="Shop" asp-action="Index">Sale</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-2 col-md-3 col-sm-6">
                    <div class="footer__widget">
                        <h6>Support</h6>
                        <ul>
                            <li><a asp-controller="Contact" asp-action="Index">Contact Us</a></li>
                            <li><a href="#">Payment Methods</a></li>
                            <li><a href="#">Delivery</a></li>
                            <li><a href="#">Return &amp; Exchanges</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-3 offset-lg-1 col-md-6 col-sm-6">
                    <div class="footer__widget">
                        <h6>NewLetter</h6>
                        <div class="footer__newslatter">
                            <p>Be the first to know about new arrivals, look books, sales &amp; promos!</p>
                            <form action="#">
                                <input type="text" placeholder="Your email">
                                <button type="submit"><span class="icon_mail_alt"></span></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12 text-center">
                    <div class="footer__copyright__text">
                        <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                        <p>
                            Copyright &copy; @DateTime.Now.Year
                            All rights reserved | This template is made with <i class="fa fa-heart-o"
                                                                                aria-hidden="true"></i> by <a href="https://colorlib.com" target="_blank">Colorlib</a>
                        </p>
                        <!-- Link back to Colorlib can't be removed. Template is licensed under CC BY 3.0. -->
                    </div>
                </div>
            </div>
        </div>
    </footer>
    <!-- Footer Section End -->
    <!-- Search Begin -->
    <div class="search-model">
        <div class="h-100 d-flex align-items-center justify-content-center">
            <div class="search-close-switch">+</div>
            <form class="search-model-form">
                <input type="text" id="search-input" placeholder="Search here.....">
            </form>
        </div>
    </div>
    <!-- Search End -->
    <!-- Storefront template JS -->
    <script src="~/storefront/js/jquery-3.3.1.min.js"></script>
    <script src="~/storefront/js/bootstrap.min.js"></script>
    <script src="~/storefront/js/jquery.nice-select.min.js"></script>
    <script src="~/storefront/js/jquery.nicescroll.min.js"></script>
    <script src="~/storefront/js/jquery.magnific-popup.min.js"></script>
    <script src="~/storefront/js/jquery.slicknav.js"></script>
    <script src="~/storefront/js/jquery.countdown.min.js"></script>
    <script src="~/storefront/js/owl.carousel.min.js"></script>
    <script src="~/storefront/js/mixitup.min.js"></script>
    <script src="~/storefront/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
