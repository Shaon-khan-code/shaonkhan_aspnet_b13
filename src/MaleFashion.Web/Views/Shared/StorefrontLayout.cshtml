<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MaleFashion</title>

    <!-- PLACEHOLDER: replace with real Sneat-storefront-template CSS links once uploaded -->
    <link rel="stylesheet" href="~/storefront/css/site.css" asp-append-version="true" />
</head>
<body>

    <partial name="_StorefrontHeader" />

    <main role="main">
        @RenderBody()
    </main>

    <partial name="_StorefrontFooter" />

    <!-- PLACEHOLDER: replace with real template JS links once uploaded -->
    <script src="~/storefront/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>