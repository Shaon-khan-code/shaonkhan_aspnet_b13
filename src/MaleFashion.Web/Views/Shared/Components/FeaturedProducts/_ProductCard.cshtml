@using MaleFashion.Web.Helpers
@model object
@{
    var id = Model.GetInt(0, "Id", "ProductId");
    var name = Model.GetText("Name", "ProductName", "Title");
    var price = Model.GetDecimal("Price", "UnitPrice", "BasePrice") ?? 0m;
    var discount = Model.GetDecimal("DiscountPrice", "SalePrice", "DiscountedPrice");
    var onSale = Model.IsOnSale();
    var image = ModelReader.ProductImage(Model.Get("ImageKey", "ImageUrl", "ImagePath", "MainImageUrl", "ThumbnailUrl", "Image"));
    var rating = Model.GetDecimal("AverageRating", "Rating") ?? 0m;
}

<div class="col-lg-3 col-md-6 col-sm-6">
    <div class="product__item @(onSale ? "sale" : "")">
        <div class="product__item__pic set-bg" data-setbg="@image" style="background-image:url('@image')">
            @if (onSale)
            {
                <span class="label">Sale</span>
            }
        </div>
        <div class="product__item__text">
            <h6>@name</h6>
            @if (id > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" style="margin:0;">
                    <input type="hidden" name="productId" value="@id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="add-cart" style="background:none;border:0;padding:0;">+ Add To Cart</button>
                </form>
            }
            <div class="rating">
                @for (var i = 1; i <= 5; i++)
                {
                    <i class="fa @(rating >= i ? "fa-star" : "fa-star-o")"></i>
                }
            </div>
            @if (onSale && discount.HasValue)
            {
                <h5>@ModelReader.Money(discount.Value) <span style="font-size:14px;color:#888;text-decoration:line-through;margin-left:6px;">@ModelReader.Money(price)</span></h5>
            }
            else
            {
                <h5>@ModelReader.Money(price)</h5>
            }
        </div>
    </div>
</div>
