
 @using MaleFashion.Web.Helpers
@using MaleFashion.Web.ViewModels.Checkout
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model MaleFashion.Web.ViewModels.Checkout.CheckoutViewModel
@{
    ViewData["Title"] = "Check Out";

    var lines = Model.Cart.ToCartLines();
    var (subtotal, total) = Model.Cart.GetCartTotals(lines);
    var modelErrors = ViewData.ModelState[string.Empty]?.Errors;

    var bkashNumber = Configuration["Payment:Bkash:MerchantNumber"] ?? "(merchant number not set)";
    var nagadNumber = Configuration["Payment:Nagad:MerchantNumber"] ?? "(merchant number not set)";
    var cardYears = Enumerable.Range(DateTime.UtcNow.Year, 11).Select(y => y.ToString()).ToList();
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Check Out</h4>
                    <div class="breadcrumb__links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Cart" asp-action="Index">Cart</a>
                        <span>Check Out</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->

<style>
    .pay-box { margin: 18px 0 20px; }
    .pay-box h6 { font-weight: 700; margin-bottom: 12px; }
    .pay-opt { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; border: 1px solid #e5e5e5; border-radius: 6px;
               padding: 10px 12px; margin-bottom: 8px; cursor: pointer; }
    .pay-opt input { margin: 0; }
    .pay-opt small { color: #888; width: 100%; padding-left: 26px; margin-top: -4px; }
    .pay-opt:has(input:checked) { border-color: #111; background: #fafafa; }
    .pay-name { font-weight: 700; padding: 2px 10px; border-radius: 12px; color: #fff; font-size: 13px; }
    .pay-name.cod { background: #2e7d32; } .pay-name.bk { background: #e2136e; } .pay-name.ng { background: #f6921e; }
    .pay-wallet { border: 1px dashed #ccc; border-radius: 6px; padding: 14px; margin-bottom: 12px; background: #fffdf8; }
    .pay-wallet p { font-size: 13px; line-height: 1.7; color: #555; margin-bottom: 10px; }
    .pay-wallet input[type=text] { width: 100%; height: 42px; border: 1px solid #e1e1e1; padding: 0 12px; margin-bottom: 4px; }
    .pay-card { border: 1px dashed #ccc; border-radius: 6px; padding: 14px; margin-bottom: 12px; background: #f8fbff; }
    .pay-card input[type=text], .pay-card input[type=password], .pay-card select { width: 100%; height: 42px; border: 1px solid #e1e1e1; padding: 0 12px; margin-bottom: 4px; background: #fff; }
    .pay-card .row-2 { display: flex; gap: 10px; }
    .pay-card .row-2 > div { flex: 1; }
    .pay-card .hint { font-size: 12px; color: #888; margin: 8px 0 0; }
    .pay-name.cd { background: #1a73e8; }
</style>

<!-- Checkout Section Begin -->
<section class="checkout spad">
    <div class="container">
        @if (modelErrors is { Count: > 0 })
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in modelErrors)
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="checkout__form">
            <form asp-controller="Checkout" asp-action="Index" method="post" novalidate>
                <div class="row">
                    <div class="col-lg-8 col-md-6">
                        <h6 class="checkout__title">Billing Details</h6>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>First Name<span>*</span></p>
                                    <input asp-for="FirstName" />
                                    <span asp-validation-for="FirstName" class="text-danger small d-block mb-2"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Last Name<span>*</span></p>
                                    <input asp-for="LastName" />
                                    <span asp-validation-for="LastName" class="text-danger small d-block mb-2"></span>
                                </div>
                            </div>
                        </div>

                        <div class="checkout__input">
                            <p>Country<span>*</span></p>
                            <input asp-for="Country" />
                            <span asp-validation-for="Country" class="text-danger small d-block mb-2"></span>
                        </div>

                        <div class="checkout__input">
                            <p>Address<span>*</span></p>
                            <input asp-for="AddressLine1" placeholder="Street Address" class="checkout__input__add" />
                            <span asp-validation-for="AddressLine1" class="text-danger small d-block mb-2"></span>
                            <input asp-for="AddressLine2" placeholder="Apartment, suite, unit etc. (optional)" />
                        </div>

                        <div class="checkout__input">
                            <p>Town / City<span>*</span></p>
                            <input asp-for="City" />
                            <span asp-validation-for="City" class="text-danger small d-block mb-2"></span>
                        </div>

                        <div class="checkout__input">
                            <p>State / Region<span>*</span></p>
                            <input asp-for="State" />
                            <span asp-validation-for="State" class="text-danger small d-block mb-2"></span>
                        </div>

                        <div class="checkout__input">
                            <p>Postcode / ZIP<span>*</span></p>
                            <input asp-for="PostalCode" />
                            <span asp-validation-for="PostalCode" class="text-danger small d-block mb-2"></span>
                        </div>

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Phone<span>*</span></p>
                                    <input asp-for="Phone" />
                                    <span asp-validation-for="Phone" class="text-danger small d-block mb-2"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="checkout__input">
                                    <p>Email<span>*</span></p>
                                    <input asp-for="Email" />
                                    <span asp-validation-for="Email" class="text-danger small d-block mb-2"></span>
                                </div>
                            </div>
                        </div>

                        <div class="checkout__input">
                            <p>Order notes</p>
                            <input asp-for="OrderNotes" placeholder="Notes about your order, e.g. special notes for delivery." />
                            <span asp-validation-for="OrderNotes" class="text-danger small d-block mb-2"></span>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <div class="checkout__order">
                            <h4 class="order__title">Your order</h4>
                            <div class="checkout__order__products">Product <span>Total</span></div>
                            <ul class="checkout__total__products">
                                @for (var i = 0; i < lines.Count; i++)
                                {
                                    <li>@((i + 1).ToString("00")). @lines[i].Name × @lines[i].Quantity <span>@ModelReader.Money(lines[i].LineTotal)</span></li>
                                }
                            </ul>
                            <ul class="checkout__total__all">
                                <li>Subtotal <span>@ModelReader.Money(subtotal)</span></li>
                                <li>Total <span>@ModelReader.Money(total)</span></li>
                            </ul>
                            <div class="pay-box">
                                <h6>Payment method</h6>

                                <label class="pay-opt">
                                    <input type="radio" asp-for="PaymentMethod" value="Card" />
                                    <span class="pay-name cd">Card</span>
                                    <small>Pay now with a debit or credit card (test mode).</small>
                                </label>

                                <label class="pay-opt">
                                    <input type="radio" asp-for="PaymentMethod" value="CashOnDelivery" />
                                    <span class="pay-name cod">Cash on Delivery</span>
                                    <small>Pay in cash when your order arrives.</small>
                                </label>
                                <label class="pay-opt">
                                    <input type="radio" asp-for="PaymentMethod" value="Bkash" />
                                    <span class="pay-name bk">bKash</span>
                                    <small>Send money from your bKash account.</small>
                                </label>
                                <label class="pay-opt">
                                    <input type="radio" asp-for="PaymentMethod" value="Nagad" />
                                    <span class="pay-name ng">Nagad</span>
                                    <small>Send money from your Nagad account.</small>
                                </label>

                                <div class="pay-wallet" id="walletPanel" style="display:none;"
                                     data-bkash="@bkashNumber" data-nagad="@nagadNumber">
                                    <p>
                                        1. Open your <b id="walletName">bKash</b> app and choose <b>Send Money</b>.<br />
                                        2. Send <b>@ModelReader.Money(total)</b> to <b id="merchantNumber">@bkashNumber</b>.<br />
                                        3. Enter your wallet number and the Transaction ID (TrxID) from the confirmation message.
                                    </p>
                                    <input asp-for="WalletNumber" type="text" placeholder="Your wallet number (01XXXXXXXXX)" autocomplete="tel" />
                                    <span asp-validation-for="WalletNumber" class="text-danger small d-block mb-2"></span>
                                    <input asp-for="TransactionId" type="text" placeholder="Transaction ID (TrxID)" autocomplete="off" />
                                    <span asp-validation-for="TransactionId" class="text-danger small d-block mb-1"></span>
                                </div>

                                <div class="pay-card" id="cardPanel" style="display:none;">
                                    <input asp-for="CardholderName" type="text" placeholder="Name on card" autocomplete="cc-name" />
                                    <span asp-validation-for="CardholderName" class="text-danger small d-block mb-2"></span>

                                    <input asp-for="CardNumber" type="text" inputmode="numeric" placeholder="Card number" autocomplete="cc-number" maxlength="23" />
                                    <span asp-validation-for="CardNumber" class="text-danger small d-block mb-2"></span>

                                    <div class="row-2">
                                        <div>
                                            <select asp-for="ExpiryMonth">
                                                <option value="">MM</option>
                                                @for (var month = 1; month <= 12; month++)
                                                {
                                                    <option value="@month.ToString("00")">@month.ToString("00")</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <select asp-for="ExpiryYear">
                                                <option value="">YYYY</option>
                                                @foreach (var year in cardYears)
                                                {
                                                    <option value="@year">@year</option>
                                                }
                                            </select>
                                        </div>
                                        <div>
                                            <input asp-for="Cvv" type="password" inputmode="numeric" placeholder="CVV" autocomplete="cc-csc" maxlength="4" />
                                        </div>
                                    </div>
                                    <span asp-validation-for="ExpiryMonth" class="text-danger small d-block"></span>
                                    <span asp-validation-for="Cvv" class="text-danger small d-block"></span>

                                    <p class="hint">Test mode: use 4242 4242 4242 4242 with any future expiry and any CVV. Card numbers ending in 0000 are declined. No real payment is taken.</p>
                                </div>
                            </div>

                            <button type="submit" class="site-btn">PLACE ORDER</button>
                            <p class="mt-3 mb-0"><a asp-controller="Cart" asp-action="Index">&larr; Back to cart</a></p>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
<!-- Checkout Section End -->

@section Scripts {
    <script>
        (function () {
            var walletPanel = document.getElementById('walletPanel');
            var cardPanel = document.getElementById('cardPanel');
            var radios = document.querySelectorAll('input[name="PaymentMethod"]');

            function update() {
                var selected = document.querySelector('input[name="PaymentMethod"]:checked');
                var method = selected ? selected.value : 'CashOnDelivery';
                var wallet = method === 'Bkash' || method === 'Nagad';

                walletPanel.style.display = wallet ? 'block' : 'none';
                cardPanel.style.display = method === 'Card' ? 'block' : 'none';

                if (wallet) {
                    document.getElementById('walletName').textContent = method === 'Bkash' ? 'bKash' : 'Nagad';
                    document.getElementById('merchantNumber').textContent = method === 'Bkash' ? walletPanel.dataset.bkash : walletPanel.dataset.nagad;
                }
            }

            radios.forEach(function (r) { r.addEventListener('change', update); });
            update();
        })();
    </script>
}
