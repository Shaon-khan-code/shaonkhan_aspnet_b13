@{
    ViewData["Title"] = "About Us";

    var highlights = new[]
    {
        (Title: "Who We Are ?", Text: "Contextual advertising programs sometimes have strict policies that need to be adhered too. Let’s take Google as an example."),
        (Title: "Who We Do ?", Text: "In this digital generation where information can be easily obtained within seconds, business cards still have retained their importance."),
        (Title: "Why Choose Us", Text: "A two or three storey house is the ideal way to maximise the piece of earth on which our home sits, but for older or infirm people.")
    };

    var counters = new[]
    {
        (Number: "102", Line1: "Our", Line2: "Clients", Suffix: ""),
        (Number: "30",  Line1: "Total", Line2: "Categories", Suffix: ""),
        (Number: "102", Line1: "In", Line2: "Country", Suffix: ""),
        (Number: "98",  Line1: "Happy", Line2: "Customer", Suffix: "%")
    };

    var team = new[]
    {
        (Img: "team-1.jpg", Name: "John Smith", Role: "Fashion Design"),
        (Img: "team-2.jpg", Name: "Christine Wise", Role: "C.E.O"),
        (Img: "team-3.jpg", Name: "Sean Robbins", Role: "Manager"),
        (Img: "team-4.jpg", Name: "Lucy Myers", Role: "Delivery")
    };
}

<!-- Breadcrumb Section Begin -->
<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>About Us</h4>
                    <div class="breadcrumb__links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <span>About Us</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb Section End -->
<!-- About Section Begin -->
<section class="about spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="about__pic">
                    <img src="/storefront/img/about/about-us.jpg" alt="About MaleFashion">
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var item in highlights)
            {
                <div class="col-lg-4 col-md-4 col-sm-6">
                    <div class="about__item">
                        <h4>@item.Title</h4>
                        <p>@item.Text</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- About Section End -->
<!-- Testimonial Section Begin -->
<section class="testimonial">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-6 p-0">
                <div class="testimonial__text">
                    <span class="icon_quotations"></span>
                    <p>
                        “Going out after work? Take your butane curling iron with you to the office, heat it up,
                        style your hair before you leave the office and you won’t have to make a trip back home.”
                    </p>
                    <div class="testimonial__author">
                        <div class="testimonial__author__pic">
                            <img src="/storefront/img/about/testimonial-author.jpg" alt="Augusta Schultz">
                        </div>
                        <div class="testimonial__author__text">
                            <h5>Augusta Schultz</h5>
                            <p>Fashion Design</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 p-0">
                <div class="testimonial__pic set-bg" data-setbg="/storefront/img/about/testimonial-pic.jpg"></div>
            </div>
        </div>
    </div>
</section>
<!-- Testimonial Section End -->
<!-- Counter Section Begin -->
<section class="counter spad">
    <div class="container">
        <div class="row">
            @foreach (var counter in counters)
            {
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="counter__item">
                        <div class="counter__item__number">
                            <h2 class="cn_num">@counter.Number</h2>
                            @if (!string.IsNullOrEmpty(counter.Suffix))
                            {
                                <strong>@counter.Suffix</strong>
                            }
                        </div>
                        <span>@counter.Line1 <br />@counter.Line2</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Counter Section End -->
<!-- Team Section Begin -->
<section class="team spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Our Team</span>
                    <h2>Meet Our Team</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var member in team)
            {
                <div class="col-lg-3 col-md-6 col-sm-6">
                    <div class="team__item">
                        <img src="/storefront/img/about/@member.Img" alt="@member.Name">
                        <h4>@member.Name</h4>
                        <span>@member.Role</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<!-- Team Section End -->
<!-- Client Section Begin -->
<section class="clients spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Partner</span>
                    <h2>Happy Clients</h2>
                </div>
            </div>
        </div>
        <div class="row">
            @for (var i = 1; i <= 8; i++)
            {
                <div class="col-lg-3 col-md-4 col-sm-4 col-6">
                    <a href="#" class="client__item"><img src="/storefront/img/clients/client-@(i).png" alt="Client @i"></a>
                </div>
            }
        </div>
    </div>
</section>
<!-- Client Section End -->
