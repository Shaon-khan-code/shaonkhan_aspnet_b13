@using System.Collections
@using System.Globalization
@using System.Text.RegularExpressions
@using MaleFashion.Application.Features.Products.Queries.GetProductList
@model MaleFashion.Web.ViewModels.Shop.ShopIndexViewModel
@{
    ViewData["Title"] = "Shop";

    const int PageSize = 12;

    var pr = Model.Products;
    var items = (Prop(pr, "Items", "Data", "Results", "Products", "Records") as IEnumerable)?.Cast<object>().ToList()
                ?? new List<object>();
    var total = ToInt(Prop(pr, "TotalCount", "TotalItems", "TotalRecords", "Total"), items.Count);
    var page = ToInt(Prop(pr, "PageNumber", "Page", "CurrentPage"), 1);
    if (page < 1) { page = 1; }
    var totalPages = ToInt(Prop(pr, "TotalPages"), (int)Math.Ceiling(total / (double)PageSize));
    var from = total == 0 ? 0 : ((page - 1) * PageSize) + 1;
    var to = total == 0 ? 0 : Math.Min(page * PageSize, total);

    string PageUrl(int p) => Url.Action("Index", "Shop", new
    {
        searchTerm = Model.SearchTerm,
        categoryId = Model.CategoryId,
        minPrice = Model.MinPrice,
        maxPrice = Model.MaxPrice,
        sortBy = Model.SortBy,
        pageNumber = p
    })!;

    string FilterUrl(int? cat, decimal? min, decimal? max) => Url.Action("Index", "Shop", new
    {
        searchTerm = Model.SearchTerm,
        categoryId = cat,
        minPrice = min,
        maxPrice = max,
        sortBy = Model.SortBy
    })!;

    var priceRanges = new (string Label, decimal? Min, decimal? Max)[]
    {
        ("All prices", null, null),
        ("$0 - $50", 0, 50),
        ("$50 - $100", 50, 100),
        ("$100 - $150", 100, 150),
        ("$150 - $200", 150, 200),
        ("$200+", 200, null)
    };
}

@functions {
    static object? Prop(object? o, params string[] names)
    {
        if (o == null) return null;
        var t = o.GetType();
        foreach (var n in names)
        {
            var p = t.GetProperty(n);
            if (p != null) return p.GetValue(o);
        }
        return null;
    }

    static int ToInt(object? o, int fallback)
    {
        if (o == null) return fallback;
        try { return Convert.ToInt32(o, CultureInfo.InvariantCulture); } catch { return fallback; }
    }

    static decimal? ToDec(object? o)
    {
        if (o == null) return null;
        try { return Convert.ToDecimal(o, CultureInfo.InvariantCulture); } catch { return null; }
    }

    static string Money(decimal d) => "$" + d.ToString("0.00", CultureInfo.InvariantCulture);

    static string Inv(decimal? d) => d?.ToString(CultureInfo.InvariantCulture) ?? "";

    string Img(object? raw)
    {
        var s = raw?.ToString()?.Trim();
        if (string.IsNullOrEmpty(s)) return Url.Content("~/storefront/img/no-image.svg");
        if (s.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return s;
        if (s.StartsWith("~/")) return Url.Content(s);
        if (s.StartsWith("/")) return s;
        if (s.StartsWith("img/", StringComparison.OrdinalIgnoreCase)) return "/storefront/" + s;
        // স্ল্যাশসহ অজানা key (যেমন S3-র products/...) ব্যাকএন্ডে URL হয়ে আসার কথা, না এলে প্লেসহোল্ডার
        if (s.Contains('/')) return Url.Content("~/storefront/img/no-image.svg");
        return "/storefront/img/product/" + s;
    }

    static string SortLabel(string name) => Regex.Replace(name, "(?<=[a-z])(?=[A-Z])", " ");
}

