                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.CategoryId.HasValue || Model.MinPrice.HasValue || Model.MaxPrice.HasValue)
                    {
                        <p class="mt-3"><a asp-controller="Shop" asp-action="Index" style="color:#e53637;font-weight:600;">&times; Clear all filters</a></p>
                    }
                </div>
            </div>

            <div class="col-lg-9">
                <div class="shop__product__option">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="shop__product__option__left">
                                <p>Showing @from–@to of @total results</p>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <div class="shop__product__option__right">
                                <form asp-controller="Shop" asp-action="Index" method="get">
                                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm)) { <input type="hidden" name="searchTerm" value="@Model.SearchTerm" /> }
                                    @if (Model.CategoryId.HasValue) { <input type="hidden" name="categoryId" value="@Model.CategoryId" /> }
                                    @if (Model.MinPrice.HasValue) { <input type="hidden" name="minPrice" value="@Inv(Model.MinPrice)" /> }
                                    @if (Model.MaxPrice.HasValue) { <input type="hidden" name="maxPrice" value="@Inv(Model.MaxPrice)" /> }
                                    <p>Sort by:</p>
                                    <select name="sortBy" onchange="this.form.submit()">
                                        @foreach (var opt in Enum.GetValues<ProductSortOption>())
                                        {
                                            <option value="@opt" selected="@(opt == Model.SortBy)">@SortLabel(opt.ToString())</option>
                                        }
                                    </select>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                @if (items.Count == 0)
                {
                    <div class="text-center py-5">
                        <h5>No products found</h5>
                        <p>Try changing your search or filters.</p>
                        <a asp-controller="Shop" asp-action="Index" class="primary-btn">View all products</a>
                    </div>
                }
                else
                {
                    <div class="row">
                        @foreach (var p in items)
                        {
                            var name = Prop(p, "Name", "ProductName", "Title")?.ToString() ?? "";
                            var price = ToDec(Prop(p, "Price", "UnitPrice", "BasePrice")) ?? 0m;
                            var discount = ToDec(Prop(p, "DiscountPrice", "SalePrice", "DiscountedPrice"));
                            var onSaleFlag = Prop(p, "IsOnSale", "OnSale") as bool?;
                            var onSale = onSaleFlag == true || (discount.HasValue && discount > 0 && discount < price);
                            var image = Img(Prop(p, "ImageUrl", "ImageKey", "ImagePath", "MainImageUrl", "PrimaryImageUrl", "ThumbnailUrl", "Image"));
                            var rating = ToDec(Prop(p, "AverageRating", "Rating")) ?? 0m;
                            var category = Prop(p, "CategoryName", "Category")?.ToString();
                            var productId = ToInt(Prop(p, "Id", "ProductId"), 0);

                            <div class="col-lg-4 col-md-6 col-sm-6 mb-4">
                                <div class="dz-card">
                                    <a class="dz-pic" asp-controller="Shop" asp-action="Details" asp-route-id="@productId">
                                        <img src="@image" alt="@name" loading="lazy"
                                             onerror="this.onerror=null;this.src='/storefront/img/no-image.svg';" />
                                        @if (onSale && discount.HasValue && discount > 0 && price > 0)
                                        {
                                            <span class="dz-badge">-@((int)Math.Round((price - discount.Value) / price * 100m))%</span>
                                        }
                                    </a>
                                    <div class="dz-body">
                                        @if (!string.IsNullOrEmpty(category))
                                        {
                                            <span class="dz-cat">@category</span>
                                        }
                                        <h6 class="dz-name"><a asp-controller="Shop" asp-action="Details" asp-route-id="@productId">@name</a></h6>
                                        <div class="dz-price">
                                            @if (onSale && discount.HasValue && discount > 0)
                                            {
                                                <span class="now">@Money(discount.Value)</span>
                                                <span class="was">@Money(price)</span>
                                            }
                                            else
                                            {
                                                <span class="now">@Money(price)</span>
                                            }
                                        </div>
                                        <a class="dz-shop" asp-controller="Shop" asp-action="Details" asp-route-id="@productId">Shop now</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="product__pagination">
                                    @if (page > 1) { <a href="@PageUrl(page - 1)">&laquo;</a> }
                                    @for (var i = 1; i <= totalPages; i++)
                                    {
                                        if (i == 1 || i == totalPages || Math.Abs(i - page) <= 2)
                                        {
                                            <a class="@(i == page ? "active" : "")" href="@PageUrl(i)">@i</a>
                                        }
                                        else if (Math.Abs(i - page) == 3)
                                        {
                                            <span>...</span>
                                        }
                                    }
                                    @if (page < totalPages) { <a href="@PageUrl(page + 1)">&raquo;</a> }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>
<!-- Shop Section End -->
