
@using System.Globalization
@model MaleFashion.Application.DTOs.ProductDto
@{
    ViewData["Title"] = Model.Name;

    var us = CultureInfo.GetCultureInfo("en-US");
    var hasDiscount = Model.DiscountPrice.HasValue && Model.DiscountPrice.Value > 0 && Model.DiscountPrice.Value < Model.Price;
    var finalPrice = hasDiscount ? Model.DiscountPrice!.Value : Model.Price;
    var percentOff = hasDiscount ? (int)Math.Round((Model.Price - finalPrice) / Model.Price * 100m) : 0;
    var image = string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/storefront/img/no-image.svg" : Model.ImageUrl;
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var loginUrl = Url.Action("Login", "Account", new { returnUrl = Url.Action("Details", "Shop", new { id = Model.Id }) });
}

<style>
    .pd-wrap {
        padding: 50px 0 70px;
    }

    .pd-image {
        background: #f3f2ee;
        border-radius: 6px;
        overflow: hidden;
    }

        .pd-image img {
            width: 100%;
            max-height: 560px;
            object-fit: contain;
            display: block;
        }

    .pd-info h2 {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .pd-meta {
        color: #888;
        font-size: 14px;
        margin-bottom: 18px;
    }

        .pd-meta a {
            color: #888;
        }

    .pd-price {
        display: flex;
        align-items: baseline;
        gap: 14px;
        padding: 18px 0;
        border-top: 1px solid #eee;
        border-bottom: 1px solid #eee;
        margin-bottom: 22px;
    }

        .pd-price .now {
            font-size: 36px;
            font-weight: 800;
            color: #f57224;
        }

        .pd-price .was {
            font-size: 18px;
            color: #999;
            text-decoration: line-through;
        }

        .pd-price .off {
            font-size: 14px;
            font-weight: 700;
            color: #111;
        }

    .pd-desc {
        color: #555;
        line-height: 1.8;
        margin-bottom: 24px;
        white-space: pre-line;
    }

    .pd-qty {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

        .pd-qty label {
            margin: 0;
            color: #666;
            font-size: 15px;
        }

    .pd-qty-box {
        display: inline-flex;
        align-items: center;
    }

        .pd-qty-box button {
            width: 40px;
            height: 40px;
            border: 1px solid #ddd;
            background: #f6f6f6;
            font-size: 20px;
            cursor: pointer;
        }

        .pd-qty-box input {
            width: 60px;
            height: 40px;
            border: 1px solid #ddd;
            border-left: 0;
            border-right: 0;
            text-align: center;
            font-size: 16px;
        }

    .pd-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .pd-btn {
        flex: 1 1 200px;
        height: 52px;
        border: 0;
        border-radius: 4px;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .pd-btn-buy {
        background: #1565c0;
        color: #fff;
    }

        .pd-btn-buy:hover {
            background: #0d47a1;
            color: #fff;
        }

    .pd-btn-cart {
        background: #2e7d32;
        color: #fff;
    }

        .pd-btn-cart:hover {
            background: #1b5e20;
            color: #fff;
        }

    .pd-btn:disabled {
        opacity: .7;
        cursor: default;
    }

    .pd-note {
        margin-top: 16px;
        font-size: 13px;
        color: #888;
    }

    .pd-pay {
        margin-top: 20px;
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
        font-size: 13px;
        color: #777;
    }

        .pd-pay b {
            padding: 3px 11px;
            border-radius: 12px;
            color: #fff;
            font-size: 12px;
        }

        .pd-pay .bk {
            background: #e2136e;
        }

        .pd-pay .ng {
            background: #f6921e;
        }

        .pd-pay .cod {
            background: #2e7d32;
        }
</style>

<section class="breadcrumb-option">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcrumb__text">
                    <h4>Product details</h4>
                    <div class="breadcrumb__links">
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Shop" asp-action="Index">Shop</a>
                        <span>@Model.Name</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pd-wrap">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="pd-image">
                    <img src="@image" alt="@Model.Name"
                         onerror="this.onerror=null;this.src='/storefront/img/no-image.svg';" />
                </div>
            </div>

            <div class="col-lg-6 pd-info">
                <h2>@Model.Name</h2>
                <div class="pd-meta">
                    @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                    {
                        <span>Category: <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.CategoryName</a></span>
                        <span> &nbsp;|&nbsp; </span>
                    }
                    <span>SKU: @Model.Sku</span>
                </div>

                <div class="pd-price">
                    <span class="now">@finalPrice.ToString("C", us)</span>
                    @if (hasDiscount)
                    {
                        <span class="was">@Model.Price.ToString("C", us)</span>
                        <span class="off">-@percentOff%</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="pd-desc">@Model.Description</p>
                }

                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="pd-qty">
                        <label for="pdQuantity">Quantity</label>
                        <div class="pd-qty-box">
                            <button type="button" id="pdMinus" aria-label="Decrease quantity">&minus;</button>
                            <input type="number" id="pdQuantity" name="quantity" value="1" min="1" max="99" />
                            <button type="button" id="pdPlus" aria-label="Increase quantity">+</button>
                        </div>
                    </div>

                    <div class="pd-actions">
                        @if (isSignedIn)
                        {
                            <button type="button" class="pd-btn pd-btn-buy" data-buy-now>Buy Now</button>
                        }
                        else
                        {
                            <a class="pd-btn pd-btn-buy" href="@loginUrl">Login to Buy Now</a>
                        }
                        <button type="submit" class="pd-btn pd-btn-cart">Add to Cart</button>
                    </div>
                </form>

                <div class="pd-pay">
                    <span>Pay with:</span>
                    <b class="bk">bKash</b><b class="ng">Nagad</b><b class="cod">Cash on Delivery</b>
                </div>

                @if (!isSignedIn)
                {
                    <p class="pd-note">Sign in to buy this product right away. You can add it to your cart without signing in.</p>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
    (function () {
        var input = document.getElementById('pdQuantity');
        function clamp(v) { v = parseInt(v, 10); if (isNaN(v) || v < 1) { v = 1; } return v > 99 ? 99 : v; }
        document.getElementById('pdMinus').addEventListener('click', function () { input.value = clamp(input.value) - 1 < 1 ? 1 : clamp(input.value) - 1; });
        document.getElementById('pdPlus').addEventListener('click', function () { input.value = clamp(input.value) + 1; });
        input.addEventListener('change', function () { input.value = clamp(input.value); });
    })();
    </script>
    <partial name="_BuyNowScript" />
}
